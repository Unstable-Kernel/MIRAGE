      "title": "RelationshipType",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": true,
      "properties": {
        "confidence": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "ref_type": {
          "title": "Ref Type",
          "type": "string"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "ref_type"
      ],
      "title": "SourceRef",
      "type": "object"
    },
    "ValidationStatus": {
      "enum": [
        "unknown",
        "valid",
        "invalid",
        "partial"
      ],
      "title": "ValidationStatus",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "eir_version": {
      "default": "0.1",
      "title": "Eir Version",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/EIRNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "relationships": {
      "items": {
        "$ref": "#/$defs/EIRRelationship"
      },
      "title": "Relationships",
      "type": "array"
    }
  },
  "required": [
    "id",
    "provenance"
  ],
  "title": "EIRDocument",
  "type": "object"
}
